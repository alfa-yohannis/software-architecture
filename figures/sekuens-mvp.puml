@startuml
skinparam backgroundColor transparent
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #E8EEF7
skinparam ParticipantBorderColor #444444
skinparam ArrowColor #333333

actor Pengguna
participant View
participant Presenter
participant Model

Pengguna -> View : menekan tombol Hitung
View -> Presenter : tangani_masukan("USD", "IDR", 100)
Presenter -> Model : konversi("USD", "IDR", 100)
Model --> Presenter : 1625000.0
Presenter -> Presenter : susun "Hasil: 1,625,000.00"
Presenter -> View : tampilkan("Hasil: 1,625,000.00")
View --> Pengguna : label diperbarui

note over Presenter, View
  View meneruskan tindakan, lalu menerima
  teks yang sudah jadi. View tidak mengenal Model
end note
@enduml
