' Diagram kelas Bab 5, inti beserta kontrak dan ketiga pluginnya.
'
' Inti hanya mengenal kontrak, bukan satu pun plugin. Seluruh panah dari plugin
' menunjuk ke kontrak, dan tidak ada panah yang berangkat dari inti menuju
' plugin. Arah itulah yang membuat penambahan plugin tidak menyentuh inti.
'
' Fontnya Titillium Web, sama dengan font naskah modul. Berkas fontnya ada di
' module/fonts/ dan harus terpasang di sistem agar PlantUML dapat memakainya.
'
' Cara menghasilkan: bash sources/chapter05/diagram/buat_diagram.sh
@startuml
skinparam backgroundColor transparent
skinparam defaultFontName Titillium Web
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 6
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam ArrowColor #257147
skinparam ArrowFontSize 12
skinparam class {
  BorderColor #257147
  BackgroundColor #EBEBFF
  FontColor black
  AttributeFontSize 12
  StereotypeFontSize 11
}
skinparam package {
  BorderColor #257147
  BackgroundColor transparent
  FontColor black
  FontSize 12
}
hide circle

package "Inti (inti.py)" {
  class Inti #DEEAE3 {
    manifes
    plugin_aktif
    temukan()
    aktifkan(perintah) : Plugin
    jalankan(perintah, argumen) : str
  }

  class Plugin <<Protocol>> #C8DBD1 {
    __init__(inti)
    jalankan(argumen)
  }
}

package "Plugin" {
  class PluginKonversi #E6FFE6 {
    inti
    jalankan(argumen)
  }
  class PluginKurs #E6FFE6 {
    inti
    jalankan(argumen)
  }
  class PluginRiwayat #E6FFE6 {
    inti
    catat(asal, tujuan, nominal)
    jalankan(argumen)
  }
}

class "plugins/plugin_*.json" as Manifes <<manifes>> {
  nama
  perintah
  keterangan
  modul
  kelas
}

Inti -right-> Manifes : membaca
Inti -down-> Plugin : memanggil lewat
PluginKonversi -up-> Plugin : mengisi
PluginKurs -up-> Plugin : mengisi
PluginRiwayat -up-> Plugin : mengisi
PluginRiwayat -up-> Inti : memanggil perintah lain
Manifes .down.> PluginKonversi : menunjuk modul dan kelas
@enduml
