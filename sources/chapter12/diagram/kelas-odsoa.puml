' Diagram kelas Bab 12, empat layer layanan beserta orchestration engine-nya.
'
' Seluruh panah pemanggilan berangkat dari orchestration engine menuju layanan, dan
' tidak ada satu pun panah antar layanan. Arah itulah yang membuat urutan
' langkah hanya tertulis di satu tempat, yaitu DEFINISI_ALUR.
'
' Fontnya Titillium Web, sama dengan font naskah modul. File fontnya ada di
' module/fonts/ dan harus terpasang di sistem agar PlantUML dapat memakainya.
'
' Cara menghasilkan: bash sources/chapter12/diagram/buat_diagram.sh
@startuml
skinparam backgroundColor transparent
skinparam defaultFontName Titillium Web
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 6
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam ArrowColor #257147
skinparam ArrowFontSize 12
skinparam nodesep 12
skinparam ranksep 24
skinparam class {
  BorderColor #257147
  BackgroundColor #EBEBFF
  FontColor black
  AttributeFontSize 12
  StereotypeFontSize 11
}
skinparam package {
  BorderColor #257147
  BackgroundColor transparent
  FontColor black
  FontSize 12
}
skinparam note {
  BackgroundColor #DEEAE3
  BorderColor #257147
  FontSize 12
}
hide circle

package "orkestrator.py" {
  class DEFINISI_ALUR <<business services>> #C8DBD1 {
    pesan-valas
    kirim-remitansi
    bayar-tagihan
    tukar-poin
    laporan-kurs
  }

  class OrchestrationEngine #DEEAE3 {
    riwayat
    mulai(alur, request)
    lanjutkan(nomor)
    panggil_layanan(langkah, konteks)
  }
}

package "Application services" {
  class bukti #E6FFE6 {
    1 dari 5 workflow
  }
}

package "Infrastructure services" {
  class audit #E6FFE6 {
    5 dari 5 workflow
  }
}

package "Enterprise services" {
  class nasabah #EBEBFF {
    4 dari 5 workflow
  }
  class kurs #EBEBFF {
    3 dari 5 workflow
  }
  class batas #EBEBFF {
    2 dari 5 workflow
  }
  class saldo #EBEBFF {
    3 dari 5 workflow
  }
  class transaksi #EBEBFF {
    4 dari 5 workflow
  }
}

' Baris atas dibaca dari kiri ke kanan: definisi, engine, lalu application dan
' infrastructure. Kelima enterprise service berjajar di baris bawah menurut
' urutan langkah pesan-valas.
DEFINISI_ALUR <-left- OrchestrationEngine : membaca urutan
OrchestrationEngine -right-> bukti
bukti -[hidden]right- audit
OrchestrationEngine --> nasabah
OrchestrationEngine --> kurs
OrchestrationEngine --> batas
OrchestrationEngine --> saldo
OrchestrationEngine --> transaksi
OrchestrationEngine -right-> audit
nasabah -[hidden]right- kurs
kurs -[hidden]right- batas
batas -[hidden]right- saldo
saldo -[hidden]right- transaksi
@enduml
